  "components": {
    "schemas": {
      "AdoptTasks": {
        "properties": {
          "task_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Task Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_ids"
        ],
        "title": "AdoptTasks"
      },
      "Body_upload_api_tasks__task_id__uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_tasks__task_id__uploads_post"
      },
      "CreateTask": {
        "properties": {
          "create_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Create Key"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "default": "新的售后咨询"
          },
          "region": {
            "type": "string",
            "maxLength": 24,
            "title": "Region",
            "default": "CN"
          },
          "channel": {
            "type": "string",
            "maxLength": 100,
            "title": "Channel",
            "default": "unknown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "create_key"
        ],
        "title": "CreateTask"
      },
      "EventInput": {
        "properties": {
          "client_event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Event Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "product_confirmed",
              "purchase_selected",
              "product_rejected",
              "product_correction",
              "step_feedback",
              "escalation_confirmed",
              "stop",
              "resume"
            ],
            "title": "Type"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_event_id",
          "type",
          "expected_version"
        ],
        "title": "EventInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "MemoryCorrection": {
        "properties": {
          "client_event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Event Id"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_event_id",
          "text",
          "expected_version"
        ],
        "title": "MemoryCorrection"
      },
      "MemoryForget": {
        "properties": {
          "client_event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Event Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_event_id",
          "expected_version"
        ],
        "title": "MemoryForget"
      },
      "MessageInput": {
        "properties": {
          "client_event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Event Id"
          },
          "text": {
            "type": "string",
            "maxLength": 16000,
            "title": "Text",
            "default": ""
          },
          "material_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Material Ids"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Asia/Shanghai"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_event_id"
        ],
        "title": "MessageInput"
      },
      "Register": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 6,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
